# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# ---- Postgres (docker-compose.yml, port 5443 so it never clashes with propicly's 5442) ----
POSTGRES_USER=aivastra
POSTGRES_PASSWORD=aivastra_dev_pw
POSTGRES_DB=aivastra_dev
POSTGRES_PORT=5443
DATABASE_URL=postgres://aivastra:aivastra_dev_pw@127.0.0.1:5443/aivastra_dev

# ---- Payload ----
# Generate: openssl rand -base64 48
PAYLOAD_SECRET=change_me_dev_only_min_32_chars_long!!
# Secret used by external callers of /api/revalidate (optional)
REVALIDATE_SECRET=change_me_revalidate_dev

# ---- Media storage ----
# local = ./media on disk (dev). r2 = Cloudflare R2 (wired later, see src/storage.ts)
STORAGE_DRIVER=local
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=

# ---- Environment & search-engine safety (fail-closed) ----
# local | staging | production. Only `production` can ever be indexed.
SITE_ENV=local
# Hosts allowed to be indexed (comma list). Leave EMPTY on every test/staging deploy; set on the live site only,
# e.g. INDEXABLE_HOSTS=aivastra.com,www.aivastra.com. Together with SITE_ENV=production and the admin switch
# (Admin -> Search visibility -> "Block search engines" OFF) all three must agree before crawlers are let in.
INDEXABLE_HOSTS=
# Test deploys never send real form emails / Mailchimp signups. Redirect form mail to a test inbox, or opt in:
TEST_MAIL_TO=
ALLOW_OUTBOUND=false

# ---- Email (form notifications). Leave SMTP_HOST empty to log emails to the console. ----
EMAIL_FROM=no-reply@aivastra.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Default recipient for the contact form (used by `pnpm import:wp`)
FORM_NOTIFY_TO=

# ---- Mailchimp (optional). Forms with "Subscribe to Mailchimp" ticked add the email to this audience. ----
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# ---- Google Search Console + GA4 (Admin → Rank Math SEO → Analytics), read-only ----
# Service account JSON key (raw or base64). Add its email as a user in Search Console and in GA4 property access.
GOOGLE_SERVICE_ACCOUNT=
GSC_PROPERTY=            # e.g. sc-domain:aivastra.com
GA4_PROPERTY_ID=         # numeric property id
# Publish notifications fall back to this address
ADMIN_EMAIL=

# ---- Scheduled jobs (WP-Cron): scheduled publish/unpublish every minute + nightly Search Console snapshot ----
# Runs inside the app server. On serverless hosts set false and call POST /api/payload-jobs/run from an external cron.
JOBS_AUTORUN=true
# ---- Comments: Akismet spam filtering (optional) ----
AKISMET_API_KEY=
