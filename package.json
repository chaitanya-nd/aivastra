{
  "name": "aivastra-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "tsc --noEmit",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v",
    "seed": "tsx scripts/seed.ts",
    "seed:reset": "tsx scripts/seed.ts --reset",
    "extract:wp": "python3 -I scripts/extract-wp.py",
    "import:wp": "tsx scripts/import-wp.ts",
    "media:regenerate": "tsx --env-file=.env scripts/regenerate-media.ts",
    "seo:rescore": "tsx --env-file=.env scripts/rescore-seo.ts",
    "check:indexing": "tsx scripts/check-indexing.ts",
    "import:media": "tsx --env-file=.env scripts/import-media.ts",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "migrate:status": "payload migrate:status",
    "crawl:diff": "tsx scripts/crawl-diff.ts",
    "gen:acf": "python3 -I scripts/gen-acf.py",
    "port:theme": "python3 -I scripts/port-theme.py",
    "postinstall": "node scripts/copy-tinymce.mjs || true",
    "tinymce:copy": "node scripts/copy-tinymce.mjs"
  },
  "packageManager": "pnpm@9.12.0",
  "dependencies": {
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/email-nodemailer": "3.93.0",
    "@payloadcms/live-preview-react": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/plugin-form-builder": "3.93.0",
    "@payloadcms/plugin-nested-docs": "3.93.0",
    "@payloadcms/plugin-redirects": "3.93.0",
    "@payloadcms/plugin-seo": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "@tinymce/tinymce-react": "^6.3.1",
    "graphql": "^16.15.0",
    "gsap": "^3.15.1",
    "jsdom": "^31.0.1",
    "lenis": "^1.3.27",
    "next": "16.4.6",
    "node-html-parser": "^9.0.7",
    "nodemailer": "^10.6.0",
    "payload": "3.93.0",
    "qrcode": "1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tinymce": "^8.10.2"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
